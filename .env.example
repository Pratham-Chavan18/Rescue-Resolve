# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://swiggy:swiggy@localhost:5432/swiggy_recovery

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ─── Demo configuration ───────────────────────────────────────────────────────
# Fixed OTP for all demo logins
DEMO_OTP=1234

# ─── API service ──────────────────────────────────────────────────────────────
API_PORT=4000

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ─── Upload limits ────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_BYTES=2097152
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp

# ─── Simulator ────────────────────────────────────────────────────────────────
# Tick interval in milliseconds for the order simulator
SIMULATOR_TICK_MS=10000

# ─── Recovery engine config ───────────────────────────────────────────────────
# Trigger thresholds (minutes)
TRIGGER_RIDER_STATIONARY_MIN=6
TRIGGER_PICKUP_DELAY_MIN=8
TRIGGER_ETA_SLIP_MIN=15
TRIGGER_PACK_DELAY_MIN=8
TRIGGER_UNCONFIRMED_MIN=5

# Per-customer rolling 30-day automatic credit cap (paise; 50000 = ₹500)
CREDIT_CAP_PAISE=50000
