# ==============================================================================
# Swiggy Unified Recovery — Production Environment Configuration (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=production

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Production: Use Supabase Session Pooler connection string (Port 5432 or 6543)
# Local: postgresql://swiggy:swiggy@localhost:5432/swiggy_recovery
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# ─── Authentication & Secrets ─────────────────────────────────────────────────
# Server-side only: JWT signing secret and token expiry
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Allowed frontend origins for HTTP and Socket.IO CORS (comma-separated list)
FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000

# Prototype Assessment Authentication:
# Fixed OTP for synthetic demo personas (Customer 9000000001, Restaurant 9000000002, etc.)
DEMO_OTP=1234

# ─── Supabase Storage for Evidence Photos ────────────────────────────────────
# Server-side only: NEVER prefix with NEXT_PUBLIC_ or expose to client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
SUPABASE_STORAGE_BUCKET=recovery-evidence

# ─── Upstash Redis REST Credentials ───────────────────────────────────────────
# Optional: Used for distributed caching / rate-limiting. Degrades gracefully if omitted.
UPSTASH_REDIS_REST_URL=https://your-upstash-cluster.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Evidence Upload Boundaries (CONSTRAINTS §4.16) ───────────────────────────
UPLOAD_MAX_SIZE_BYTES=2097152
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp

# ─── Telemetry & Simulation Engine ───────────────────────────────────────────
SIMULATOR_TICK_MS=10000

TRIGGER_RIDER_STATIONARY_MIN=6
TRIGGER_PICKUP_DELAY_MIN=8
TRIGGER_ETA_SLIP_MIN=15
TRIGGER_PACK_DELAY_MIN=8
TRIGGER_UNCONFIRMED_MIN=5

# Per-customer rolling 30-day automatic credit cap (in integer paise; 50000 = ₹500)
CREDIT_CAP_PAISE=50000

# ─── Render Web Service Port ──────────────────────────────────────────────────
# Render assigns PORT dynamically. For local development, falls back to API_PORT (4000).
PORT=4000
API_PORT=4000

# ─── Vercel Frontend Public Variables (apps/web) ─────────────────────────────
# Required in Vercel project environment settings:
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
NEXT_PUBLIC_WS_URL=https://your-api.onrender.com
