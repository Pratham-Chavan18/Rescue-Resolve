# ==============================================================================
# Vercel Frontend Environment Variables (apps/web)
# ==============================================================================

# Production URL of your NestJS backend deployed on Render
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# WebSocket URL (typically identical to NEXT_PUBLIC_API_URL on Render)
NEXT_PUBLIC_WS_URL=https://your-api.onrender.com
