{
  "name": "swiggy-recovery",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@swiggy/web",
    "dev:api": "turbo run dev --filter=@swiggy/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @swiggy/api run prisma:generate",
    "db:migrate": "pnpm --filter @swiggy/api run prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @swiggy/api run prisma:migrate:deploy",
    "db:seed": "pnpm --filter @swiggy/api run prisma:seed",
    "build:api": "turbo run build --filter=...@swiggy/api",
    "build:web": "turbo run build --filter=...@swiggy/web",
    "start:api": "pnpm --filter @swiggy/api start"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "@playwright/test": "^1.48.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
